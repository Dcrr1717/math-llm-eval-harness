{"uid": "own/0015", "dataset": "own", "topic": "fractions", "model_alias": "haiku", "model_id": "claude-haiku-5-5", "answer_ref": "60", "answer_extracted": "60", "correct": true, "grade_method": "exact", "input_tokens": 105, "output_tokens": 39, "cost_usd": 3e-05, "latency_s": 1.2864491939544678, "stop_reason": "end_turn", "from_cache": false, "output_text": "3/4 of 80 sacks is (3/4) × 80 = 60 sacks.\n\n\\boxed{60}"}
